# Copy this file to start.local.env for repeat local start.sh runs.

# Required for certbot issuance and renewal registration.
ADMIN_EMAIL=admin@example.com

# Required. The region of the instance and of its Session Manager endpoint.
AWS_REGION=us-east-1

# Required. Set the TLS domain to reconcile.
DOMAIN=your.domain.example

# Required. Set the Route53 hosted zone ID for DNS updates.
ROUTE53_HOSTED_ZONE_ID=your-hosted-zone-id

# Optional. When set, start.sh installs the Let's Encrypt backup hook.
LETSENCRYPT_BACKUP_AGE_PUBLIC_KEY=

# Required. SSH login, key, and the known_hosts file that pins the host key under the
# alias market-data-notification-production. start.sh takes no positional arguments.
SSH_USER=your-ssh-user
SSH_PRIVATE_KEY_PATH=/absolute/path/to/private_key
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts

# Required unless --skip-deploy. Prefer exporting it in the shell over storing it here.
# MARKET_DATA_NOTIFICATION_DEPLOY_TOKEN=

# Use the CLI flag when you want to skip the backend deploy dispatch for a one-off
# host-only reconciliation: ./scripts/start.sh --skip-deploy
