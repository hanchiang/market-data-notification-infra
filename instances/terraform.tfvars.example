# Copy this file to terraform.tfvars for local Terraform runs.

ssh_private_key_path = "/absolute/path/to/private_key"
ssh_public_key_path  = "/absolute/path/to/public_key.pub"
ssh_user             = "your-ssh-user"

# Required, no default. GitHub OIDC subjects allowed to assume the cost report
# reader role. Just the default branch of the repo that runs the cost report
# workflow: schedule and workflow_dispatch both run only from the default
# branch, so a branch subject could never be exercised and would only widen
# the trust policy.
#
# There is no default because this repository is public and the consuming
# repository is private, so a value committed anywhere in this repo would
# publish its name. Supply it either as a Terraform Cloud workspace variable
# or as a line in the gitignored terraform.tfvars -- CLI-driven remote runs
# upload the working directory including gitignored files, so the value still
# reaches the run (a VCS-driven workspace would not see it). Until set by one
# route, every plan of this workspace fails with "No value for required
# variable", including plans for unrelated changes.
cost_report_github_subjects = ["repo:OWNER/REPO:ref:refs/heads/master"]
