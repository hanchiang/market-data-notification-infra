include /etc/nginx/common/market_data_notification_upstream.conf;

include /etc/nginx/common/json_log.conf;

# Catches a Host matching no server_name, which is what a raw-IP scan sends.
# 444 drops the connection instead of redirecting the scanner into the app.
# This is a traffic policy, not a logging fix — the JSON log is kept whole by the
# playbook removing /etc/nginx/sites-enabled/default, and deleting this block
# would restore the old 301 behaviour without corrupting anything.
# Two invariants: it must stay the FIRST :80 block, since with no `default_server`
# declared anywhere nginx makes the first one the default; and it must NOT declare
# `default_server`, because then a restored distro default site is a boot failure
# (duplicate default server) rather than a recoverable logging regression.
server {
  listen 80;
  listen [::]:80;

  server_name _;

  access_log /var/log/nginx/access.log json_combined;

  return 444;
}

server {
  listen 80;
  listen [::]:80;

  server_name {{ DOMAIN }};

  # Every server block needs this line explicitly: the http-level default in the
  # unmanaged /etc/nginx/nginx.conf is plain `combined` into this same file, so a
  # block without it silently corrupts the JSON log. 38% of the log was
  # unparseable before 2026-09-07 for exactly this reason.
  access_log /var/log/nginx/access.log json_combined;

  return 301 https://$host$request_uri;
}

limit_req_zone $binary_remote_addr zone=market_data_notification_limit:10m rate=3r/s;

server {
  listen 443 ssl;

  ssl_certificate      /etc/letsencrypt/live/{{ DOMAIN }}/fullchain.pem;
  ssl_certificate_key  /etc/letsencrypt/live/{{ DOMAIN }}/privkey.pem;

  server_name {{ DOMAIN }};

  server_tokens off;
  client_max_body_size 1m;

  access_log /var/log/nginx/access.log json_combined;
  error_log /var/log/nginx/error.log;

  include /etc/nginx/common/favicon_location.conf;

  location / {
    limit_req zone=market_data_notification_limit burst=6 delay=2;
    limit_req_status 444;
    include /etc/nginx/common/market_data_notification_proxy.conf;
  }
}
