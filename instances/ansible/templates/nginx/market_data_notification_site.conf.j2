include /etc/nginx/common/market_data_notification_upstream.conf;

include /etc/nginx/common/json_log.conf;

# Catch-all for a Host that matches no server_name — which is what a raw-IP scan
# sends. Without it these fall to the distro's default site, which sets no
# access_log and inherits nginx's plain `combined` into this same file. That was
# measured: a curl to the instance IP wrote a non-JSON line on 2026-09-07.
# 444 closes the connection without a response rather than redirecting a scanner.
server {
  listen 80 default_server;
  listen [::]:80 default_server;

  server_name _;

  access_log /var/log/nginx/access.log json_combined;

  return 444;
}

server {
  listen 80;
  listen [::]:80;

  server_name {{ DOMAIN }};

  # Without this the block inherits nginx's default plain `combined` format,
  # which writes to this same file: 38% of the retained access log was
  # unparseable as JSON because every http:// request landed there.
  access_log /var/log/nginx/access.log json_combined;

  return 301 https://$host$request_uri;
}

limit_req_zone $binary_remote_addr zone=market_data_notification_limit:10m rate=3r/s;

server {
  listen 443 ssl;

  ssl_certificate      /etc/letsencrypt/live/{{ DOMAIN }}/fullchain.pem;
  ssl_certificate_key  /etc/letsencrypt/live/{{ DOMAIN }}/privkey.pem;

  server_name {{ DOMAIN }};

  server_tokens off;
  client_max_body_size 1m;

  access_log /var/log/nginx/access.log json_combined;
  error_log /var/log/nginx/error.log;

  include /etc/nginx/common/favicon_location.conf;

  location / {
    limit_req zone=market_data_notification_limit burst=6 delay=2;
    limit_req_status 444;
    include /etc/nginx/common/market_data_notification_proxy.conf;
  }
}
